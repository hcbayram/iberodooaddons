<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Senaryonun üreticisi: Bursa merkezli bir bağlantı elemanı fabrikası.
             Türkiye muhasebe planının doğru şekilde yüklenmesi (bkz. hooks.py
             _ensure_turkish_chart) bu kaydın country_id alanına bağlıdır. -->
        <record id="base.main_company" model="res.company">
            <field name="name">MAXTECH Bağlantı A.Ş.</field>
        </record>

        <record id="base.main_partner" model="res.partner">
            <field name="name">MAXTECH Bağlantı A.Ş.</field>
            <field name="is_company" eval="True"/>
            <field name="company_type">company</field>
            <field name="vat">1234567890</field>
            <field name="street">Bursa Organize Sanayi Bölgesi, Bağlantı Elemanları Cad. No: 14</field>
            <field name="city">Nilüfer/Bursa</field>
            <field name="zip">16140</field>
            <field name="country_id" ref="base.tr"/>
            <field name="phone">+90 224 219 00 00</field>
            <field name="email">info@maxtech-baglanti.example.com</field>
            <field name="website">https://www.maxtech-baglanti.example.com</field>
        </record>

    </data>
</odoo>
