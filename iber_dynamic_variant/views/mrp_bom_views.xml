<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        BOM Satırı Liste Görünümü — dinamik alanları isteğe bağlı sütun olarak ekle
    -->
    <record id="mrp_bom_form_view_iber_dynamic" model="ir.ui.view">
        <field name="name">mrp.bom.form.iber.dynamic.variant</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <!--
                bom_line_ids listesinde product_qty sütunundan sonra
                dinamik nitelik / sabit değer / formül sütunları (varsayılan gizli)
            -->
            <xpath
                expr="//field[@name='bom_line_ids']//list//field[@name='product_qty']"
                position="after"
            >
                <field
                    name="iber_dynamic_attribute_ids"
                    widget="many2many_tags"
                    optional="hide"
                    string="Din. Nitelikler"
                />
                <field
                    name="iber_dynamic_fixed_ptav_ids"
                    widget="many2many_tags"
                    optional="hide"
                    string="Sabit Nitelik Değerleri"
                />
                <field
                    name="iber_quantity_formula"
                    optional="hide"
                    string="Miktar Formülü"
                />
            </xpath>
            <!-- Yedek alanları liste satırında gizle -->
            <xpath
                expr="//field[@name='bom_line_ids']//list"
                position="inside"
            >
                <field name="iber_dynamic_product_id_backup" column_invisible="True" />
                <field name="iber_dynamic_product_qty_backup" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <!--
        BOM Satırı Form Diyaloğu — dinamik alanları Bileşen grubunun altına ekle
    -->
    <record id="mrp_bom_line_view_form_iber_dynamic" model="ir.ui.view">
        <field name="name">mrp.bom.line.form.iber.dynamic.variant</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form" />
        <field name="arch" type="xml">
            <!--
                bom_product_template_attribute_value_ids'den sonra yeni grup ekle
            -->
            <xpath
                expr="//field[@name='bom_product_template_attribute_value_ids']"
                position="after"
            >
                <separator string="Dinamik Varyant Seçimi" />

                <field
                    name="iber_dynamic_attribute_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    string="Dinamik Nitelikler"
                />
                <field
                    name="iber_dynamic_fixed_ptav_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    string="Ek Sabit Nitelik Değerleri"
                />

                <separator string="Dinamik Miktar" />

                <field name="iber_quantity_formula" />

                <!-- Teknik yedekleme alanları: görünmez -->
                <field name="iber_dynamic_product_id_backup" invisible="1" />
                <field name="iber_dynamic_product_qty_backup" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
