<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Outgoing Invoice -->
        <record id="action_ubl_invoice_outgoing" model="ir.actions.act_window">
            <field name="name">Outgoing Invoices</field>
            <field name="res_model">l10n_tr.ubl.invoice</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('invoice_direction','=','outgoing')]</field>
            <field name="context">{'default_invoice_direction': 'outgoing'}</field>
        </record>
        <!-- Incoming Invoice -->
        <record id="action_ubl_invoice_incoming" model="ir.actions.act_window">
            <field name="name">Incoming Invoices</field>
            <field name="res_model">l10n_tr.ubl.invoice</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('invoice_direction','=','incoming')]</field>
            <field name="context">{'default_invoice_direction': 'incoming'}</field>
        </record>
        <!-- Outgoing Delivery Note -->
        <record id="action_ubl_delivery_note_outgoing" model="ir.actions.act_window">
            <field name="name">Outgoing Despatch Advices</field>
            <field name="res_model">l10n_tr.ubl.delivery.note</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('document_direction','=','outgoing')]</field>
            <field name="context">{'default_document_direction': 'outgoing'}</field>
        </record>
        <!-- Incoming Delivery Note -->
        <record id="action_ubl_delivery_note_incoming" model="ir.actions.act_window">
            <field name="name">Incoming Despatch Advices</field>
            <field name="res_model">l10n_tr.ubl.delivery.note</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('document_direction','=','incoming')]</field>
            <field name="context">{'default_document_direction': 'incoming'}</field>
        </record>
        <!-- Settings — server action: her zaman singleton kaydı açar -->
        <record id="action_ubl21_config_settings_server" model="ir.actions.server">
            <field name="name">e-Transformation Settings</field>
            <field name="model_id" ref="model_ubl21_config_settings"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_settings()</field>
        </record>
        <!-- Eski act_window action'ı geriye dönük uyumluluk için (artık kullanılmıyor) -->
        <record id="action_ubl21_config_settings" model="ir.actions.act_window">
            <field name="name">e-Transformation Settings</field>
            <field name="res_model">ubl21.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

        <!-- Branch -->
        <record id="action_algebra_base_branch" model="ir.actions.act_window">
            <field name="name">Branches</field>
            <field name="res_model">algebra.base.branch</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Document Unit -->
        <record id="action_algebra_base_document_unit" model="ir.actions.act_window">
            <field name="name">Unit Codes</field>
            <field name="res_model">algebra.base.document.unit</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Profile ID -->
        <record id="action_algebra_base_document_profile_id" model="ir.actions.act_window">
            <field name="name">Invoice Profiles</field>
            <field name="res_model">algebra.base.document.profile.id</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Document Type -->
        <record id="action_algebra_base_document_type" model="ir.actions.act_window">
            <field name="name">Invoice Types</field>
            <field name="res_model">algebra.base.document.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Party ID Type -->
        <record id="action_l10n_tr_ubl_partyid_type" model="ir.actions.act_window">
            <field name="name">Party ID Types</field>
            <field name="res_model">l10n_tr.ubl.partyid.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Tax Type -->
        <record id="action_l10n_tr_ubl_tax_type" model="ir.actions.act_window">
            <field name="name">Tax Types</field>
            <field name="res_model">l10n_tr.ubl.tax.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <!-- Tax Exemption Reason -->
        <record id="action_tax_exemption_reason" model="ir.actions.act_window">
            <field name="name">VAT Exemption Reasons</field>
            <field name="res_model">tax.exemption.reason</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
