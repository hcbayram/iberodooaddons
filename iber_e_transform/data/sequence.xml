<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!--
            GIB e-Fatura belge numarası formatı (zorunlu):
            [3 BÜYÜK HARF][4 RAKAM YIL][9 RAKAM SIRA] = toplam 16 karakter
            Örnek: IBR2025000000001
            Prefix'teki harfler firmanın kendi serisi olabilir (GIB kayıtlı olmalı)
        -->
        <record id="seq_ubl_invoice" model="ir.sequence">
            <field name="name">UBL Invoice Sequence</field>
            <field name="code">l10n_tr.ubl.invoice</field>
            <field name="prefix">IBR%(year)s</field>
            <field name="padding">9</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_ubl_delivery_note" model="ir.sequence">
            <field name="name">UBL Delivery Note Sequence</field>
            <field name="code">l10n_tr.ubl.delivery.note</field>
            <field name="prefix">IBR%(year)s</field>
            <field name="padding">9</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
