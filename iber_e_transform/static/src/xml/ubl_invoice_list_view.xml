<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="iber_e_transform.UBLInvoiceListRenderer"
       t-inherit="web.ListRenderer"
       t-inherit-mode="extension">
        <xpath expr="//table" position="before">
            <t t-if="props.list.resModel === 'l10n_tr.ubl.invoice'">
                <div class="o_iber_ubl_toolbar px-3 py-2 border-bottom d-flex align-items-center gap-2 flex-wrap bg-view">

                    <!-- Giden Faturalar -->
                    <t t-if="props.list.context and props.list.context.default_invoice_direction === 'outgoing'">
                        <button type="button" class="btn btn-success"
                                t-on-click="() => env.bus.trigger('ubl_inv:fatura_guncelle')">
                            <i class="fa fa-refresh me-1"/> Update Invoices
                        </button>
                        <button type="button" class="btn btn-primary"
                                t-att-disabled="!props.list.selection.length"
                                t-on-click="() => env.bus.trigger('ubl_inv:gib_gonder')">
                            <i class="fa fa-paper-plane me-1"/> Send to GIB
                        </button>
                        <button type="button" class="btn btn-info"
                                t-att-disabled="props.list.selection.length !== 1"
                                t-on-click="() => env.bus.trigger('ubl_inv:pdf_onizle')">
                            <i class="fa fa-file-pdf-o me-1"/> PDF Preview
                        </button>
                        <button type="button" class="btn btn-secondary"
                                t-att-disabled="!props.list.selection.length"
                                t-on-click="() => env.bus.trigger('ubl_inv:gib_sifirla')">
                            <i class="fa fa-undo me-1"/> Reset GIB Status
                        </button>
                    </t>

                    <!-- Gelen Faturalar -->
                    <t t-if="props.list.context and props.list.context.default_invoice_direction === 'incoming'">
                        <!-- Tarih filtre combobox -->
                        <div class="d-flex align-items-center gap-1 me-2">
                            <label class="small text-muted mb-0 me-1">Period:</label>
                            <select class="form-select form-select-sm"
                                    style="width:140px"
                                    t-on-change="(ev) => env.bus.trigger('ubl_inv:tarih_filtre', ev.target.value)">
                                <option value="son_30_gun">Last 30 Days</option>
                                <option value="bu_ay">This Month</option>
                                <option value="bu_hafta">This Week</option>
                                <option value="bugun">Today</option>
                                <option value="tumu">All</option>
                            </select>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-success"
                                    t-on-click="() => env.bus.trigger('ubl_inv:entegrator_getir')">
                                <i class="fa fa-cloud-download me-1"/> Fetch Invoices from Integrator
                            </button>
                            <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="visually-hidden">Other fetch options</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="#"
                                       title="Test purposes only: fetches the last 10 invoices from the integrator regardless of date range (works on an integrator with test environment active)"
                                       t-on-click.prevent="() => env.bus.trigger('ubl_inv:son_n_getir')">
                                        <i class="fa fa-flask me-1"/> Fetch Last 10 Invoices (Test)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#"
                                       title="If you know the document's UUID (GUID), this fetches it directly without needing a list/date filter"
                                       t-on-click.prevent="() => env.bus.trigger('ubl_inv:uuid_ile_getir')">
                                        <i class="fa fa-search me-1"/> Fetch by UUID
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"/></li>
                                <li>
                                    <a class="dropdown-item" href="#"
                                       t-on-click.prevent="() => env.bus.trigger('ubl_inv:xml_ice_aktar')">
                                        <i class="fa fa-upload me-1"/> Import from XML
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <button type="button" class="btn btn-info"
                                t-att-disabled="props.list.selection.length !== 1"
                                t-on-click="() => env.bus.trigger('ubl_inv:pdf_onizle')">
                            <i class="fa fa-file-pdf-o me-1"/> PDF Preview
                        </button>
                        <button type="button" class="btn btn-secondary"
                                t-att-disabled="!props.list.selection.length"
                                t-on-click="() => env.bus.trigger('ubl_inv:sistem_faturasi_donustur')">
                            <i class="fa fa-exchange me-1"/> Convert to System Invoice
                        </button>
                    </t>

                </div>
            </t>
        </xpath>
    </t>

</templates>
