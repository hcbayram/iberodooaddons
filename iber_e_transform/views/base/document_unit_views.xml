<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_algebra_base_document_unit_list" model="ir.ui.view">
            <field name="name">algebra.base.document.unit.list</field>
            <field name="model">algebra.base.document.unit</field>
            <field name="arch" type="xml">
                <list string="Birim Kodları">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        <record id="view_algebra_base_document_unit_form" model="ir.ui.view">
            <field name="name">algebra.base.document.unit.form</field>
            <field name="model">algebra.base.document.unit</field>
            <field name="arch" type="xml">
                <form string="Birim Kodu">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="ERP Eşleşmeleri">
                                <field name="erp_mapping_ids">
                                    <list editable="bottom">
                                        <field name="erp_system"/>
                                        <field name="erp_code"/>
                                        <field name="erp_description"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
