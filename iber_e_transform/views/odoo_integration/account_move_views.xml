<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- account.move form: E-Dönüşüm smart button + tab -->
        <record id="view_account_move_e_transform" model="ir.ui.view">
            <field name="name">account.move.e.transform.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Smart Button -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_ubl_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text"
                        invisible="move_type not in ['out_invoice','out_refund'] or ubl_invoice_count == 0">
                        <field name="ubl_invoice_count" widget="statinfo" string="E-Fatura"/>
                    </button>
                </xpath>

                <!-- E-Dönüşüm Tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="E-Dönüşüm"
                        invisible="move_type not in ['out_invoice', 'out_refund']">
                        <group>
                            <field name="ubl_status" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_create_ubl_invoice"
                                string="E-Fatura Oluştur"
                                type="object"
                                class="btn-primary"
                                invisible="ubl_invoice_count != 0 or state != 'posted'"/>
                            <button name="action_view_ubl_invoices"
                                string="E-Faturayı Görüntüle"
                                type="object"
                                invisible="ubl_invoice_count == 0"/>
                        </group>
                        <field name="ubl_invoice_ids" readonly="1">
                            <list>
                                <field name="id_value"/>
                                <field name="issue_date"/>
                                <field name="profile_id"/>
                                <field name="UUID"/>
                                <field name="total_with_tax"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
