<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_l10n_tr_ubl_partyid_type_list" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.partyid.type.list</field>
            <field name="model">l10n_tr.ubl.partyid.type</field>
            <field name="arch" type="xml">
                <list string="Taraf Kimlik Tipleri">
                    <field name="name"/>
                    <field name="scheme_code"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        <record id="view_l10n_tr_ubl_partyid_type_form" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.partyid.type.form</field>
            <field name="model">l10n_tr.ubl.partyid.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="scheme_code"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
