<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_algebra_base_document_profile_id_list" model="ir.ui.view">
            <field name="name">algebra.base.document.profile.id.list</field>
            <field name="model">algebra.base.document.profile.id</field>
            <field name="arch" type="xml">
                <list string="Fatura Profilleri">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="profile_type"/>
                </list>
            </field>
        </record>
        <record id="view_algebra_base_document_profile_id_form" model="ir.ui.view">
            <field name="name">algebra.base.document.profile.id.form</field>
            <field name="model">algebra.base.document.profile.id</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="profile_type"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
