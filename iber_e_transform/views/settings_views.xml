<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_ubl21_config_settings_form" model="ir.ui.view">
            <field name="name">ubl21.config.settings.form</field>
            <field name="model">ubl21.config.settings</field>
            <field name="arch" type="xml">
                <form string="e-Transformation Settings">
                    <header>
                        <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <notebook>
                            <!-- Genel Ayarlar -->
                            <page string="General">
                                <group string="ERP Integration">
                                    <field name="active_erp" widget="radio"/>
                                </group>
                                <group string="UBL Service">
                                    <field name="ubl_service_url"/>
                                </group>
                                <group string="Company Information">
                                    <group>
                                        <field name="erp_company_name"/>
                                        <field name="erp_vkn_tckn"/>
                                        <field name="erp_tax_office"/>
                                        <field name="erp_pname"/>
                                        <field name="erp_psurname"/>
                                    </group>
                                    <group>
                                        <field name="erp_street"/>
                                        <field name="erp_county"/>
                                        <field name="erp_city"/>
                                        <field name="erp_postal_code"/>
                                        <field name="erp_country_code"/>
                                        <field name="erp_country_name"/>
                                    </group>
                                </group>
                                <group string="Sending">
                                    <field name="erp_sender_alias"/>
                                </group>
                            </page>


                            <!-- Senkronizasyon Durumu -->
                            <page string="Synchronization">
                                <group string="Last Sync Times">
                                    <field name="last_invoice_sync_datetime" readonly="1"/>
                                    <button name="action_clear_invoice_sync_time"
                                        string="Reset Invoice Sync Time"
                                        type="object"
                                        class="btn-secondary"/>
                                    <field name="last_delivery_note_sync_datetime" readonly="1"/>
                                    <button name="action_clear_delivery_note_sync_time"
                                        string="Reset Despatch Advice Sync Time"
                                        type="object"
                                        class="btn-secondary"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
