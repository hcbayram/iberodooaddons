<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_ubl_invoice_iade_form" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoice.iade.form</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="İade Referansları"
                        invisible="document_type_code not in ['IADE','TEVKIFATIADE']">
                        <field name="return_reference_ids">
                            <list editable="bottom">
                                <field name="invoice_number"/>
                                <field name="issue_date"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
