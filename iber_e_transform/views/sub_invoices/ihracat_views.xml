<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- İhracat: satır listesine istisna sebebi, GTIP, incoterm, taşıma tipi sütunları ekle -->
        <record id="view_ubl_invoice_line_ihracat" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoiceline.list.ihracat</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/list/field[@name='tax_amount']" position="after">
                    <field name="tax_exemption_reason_id"
                        string="İstisna Sebebi (İhracat)"
                        column_invisible="parent.profile_code != 'IHRACAT'"
                        domain="[('invoice_type', '=', 'IHRACAT')]"/>
                    <field name="gtip_num"
                        column_invisible="parent.profile_code != 'IHRACAT' and parent.document_type_code != 'IHRACKAYITLI'"/>
                    <field name="incoterm_code"
                        column_invisible="parent.profile_code != 'IHRACAT'"/>
                    <field name="transport_type"
                        column_invisible="parent.profile_code != 'IHRACAT'"/>
                    <!-- Konteyner / izleme bilgileri -->
                    <field name="product_traceID"
                        string="Ürün İzleme No"
                        column_invisible="parent.profile_code != 'IHRACAT'"/>
                    <field name="container_number"
                        string="Konteyner No"
                        column_invisible="parent.profile_code != 'IHRACAT'"/>
                    <field name="container_count"
                        string="Konteyner Adedi"
                        column_invisible="parent.profile_code != 'IHRACAT'"/>
                    <field name="container_type"
                        string="Konteyner Tipi"
                        column_invisible="parent.profile_code != 'IHRACAT'"/>
                </xpath>
            </field>
        </record>

        <!-- İhracat: fatura formuna teslimat sayfası ekle -->
        <record id="view_ubl_invoice_ihracat_form" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoice.ihracat.form</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="İhracat Teslimat"
                        invisible="profile_code != 'IHRACAT'">
                        <group>
                            <field name="delivery_street"/>
                            <field name="delivery_county"/>
                            <field name="delivery_city"/>
                            <field name="delivery_postal_code"/>
                            <field name="delivery_country_code"/>
                            <field name="delivery_country_name"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
