<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- İhraç Kayıtlı: satır listesine istisna sebebi ve alıcı satır no sütunu ekle -->
        <record id="view_ubl_invoice_line_ihrackayitli" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoiceline.list.ihrackayitli</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/list/field[@name='tax_amount']" position="after">
                    <field name="tax_exemption_reason_id"
                        string="Export Registration Reason"
                        column_invisible="parent.document_type_code != 'IHRACKAYITLI'"
                        domain="[('invoice_type', '=', 'IHRACKAYITLI')]"/>
                    <field name="buyer_linenum"
                        column_invisible="parent.document_type_code != 'IHRACKAYITLI'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
