<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_ubl_invoice_sgk_form" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoice.sgk.form</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="SGK Information" invisible="document_type_code != 'SGK'">
                        <group>
                            <field name="sgk_invoice_type"/>
                            <field name="sgk_company_code"/>
                            <field name="sgk_company_name"/>
                            <field name="sgk_file_number"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
