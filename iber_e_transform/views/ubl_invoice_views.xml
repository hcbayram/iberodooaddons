<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Invoice List View -->
        <record id="view_ubl_invoice_list" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoice.list</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="arch" type="xml">
                <list string="UBL Invoices" decoration-info="invoice_direction == 'incoming'">
                    <field name="id_value"/>
                    <field name="issue_date"/>
                    <field name="invoice_direction"/>
                    <field name="customer_name"/>
                    <field name="customer_vkn_tckn"/>
                    <field name="profile_id" domain="[('profile_type', '=', 'invoice')]"/>
                    <field name="document_type_id" domain="[('doc_type', 'in', ['invoice', 'credit_note', 'receipt'])]"/>
                    <field name="total_with_tax"/>
                    <field name="document_currency_id"/>
                    <field name="account_move_id" string="Source Invoice" optional="show"/>
                    <field name="erp_id" optional="hide"/>
                    <field name="erp_last_sync_date" optional="hide"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Invoice Form View -->
        <record id="view_ubl_invoice_form" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoice.form</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="arch" type="xml">
                <form string="UBL Invoice" create="0">
                    <header>
                        <button name="action_send_to_ubl_service"
                            string="Send to GIB"
                            type="object"
                            class="btn-primary"
                            invisible="gib_status in ['sent','approved']"/>
                        <button name="action_preview_pdf"
                            string="PDF Preview"
                            type="object"
                            invisible="pdf_data"/>
                        <button name="action_clear_pdf_preview"
                            string="Close Preview"
                            type="object"
                            invisible="not pdf_data"/>
                        <field name="gib_status" widget="statusbar"
                            statusbar_visible="draft,xml_created,sent,approved"/>
                    </header>
                    <sheet>
                        <div class="o_iber_form_with_pdf">

                            <!-- Sol kolon: form alanları -->
                            <div class="o_iber_form_main_col">

                                <!-- Kaynak Fatura Smart Button -->
                                <div class="oe_button_box" name="button_box">
                                    <button name="action_view_account_move"
                                        type="object"
                                        class="oe_stat_button"
                                        icon="fa-file-text-o"
                                        invisible="not account_move_id">
                                        <div class="o_stat_info">
                                            <span class="o_stat_text">Accounting Entry</span>
                                        </div>
                                    </button>
                                </div>

                                <!-- GIB belge numarası format uyarısı -->
                                <div class="alert alert-warning mb-2"
                                     invisible="not id_value_warning"
                                     role="alert">
                                    <i class="fa fa-exclamation-triangle me-1"/>
                                    <field name="id_value_warning" readonly="1" nolabel="1" class="d-inline"/>
                                </div>

                                <group>
                                    <group>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                        <field name="branch_id"/>
                                        <field name="invoice_direction"/>
                                        <field name="customization_id"/>
                                        <field name="profile_id" domain="[('profile_type', '=', 'invoice')]"/>
                                        <field name="document_type_id" domain="[('doc_type', 'in', ['invoice', 'credit_note', 'receipt'])]"/>
                                    </group>
                                    <group>
                                        <field name="issue_date"/>
                                        <field name="UUID" readonly="1"/>
                                        <field name="id_value" required="1"/>
                                        <field name="document_currency_id"/>
                                        <field name="document_exchange_rate"/>
                                        <field name="account_move_id" string="Source Invoice"/>
                                        <field name="customer_receiver_alias" invisible="invoice_direction == 'incoming'"/>
                                    </group>
                                </group>

                                <notebook>
                            <!-- Gönderici -->
                            <page string="Sender">
                                <group>
                                    <group>
                                        <field name="supplier_name"/>
                                        <field name="supplier_vkn_tckn"/>
                                        <field name="supplier_scheme_id"/>
                                        <field name="supplier_tax_office"/>
                                        <field name="supplier_pname"/>
                                        <field name="supplier_psurname"/>
                                    </group>
                                    <group>
                                        <field name="supplier_street"/>
                                        <field name="supplier_county"/>
                                        <field name="supplier_city"/>
                                        <field name="supplier_postal_code"/>
                                        <field name="supplier_country_code"/>
                                        <field name="supplier_country_name"/>
                                    </group>
                                </group>
                            </page>

                            <!-- Alıcı -->
                            <page string="Receiver">
                                <group>
                                    <group>
                                        <field name="customer_card_code"/>
                                        <field name="customer_name"/>
                                        <field name="customer_vkn_tckn"/>
                                        <field name="customer_scheme_id"/>
                                        <field name="customer_tax_office"/>
                                        <field name="customer_pname"/>
                                        <field name="customer_psurname"/>
                                    </group>
                                    <group>
                                        <field name="customer_street"/>
                                        <field name="customer_county"/>
                                        <field name="customer_city"/>
                                        <field name="customer_postal_code"/>
                                        <field name="customer_country_code"/>
                                        <field name="customer_country_name"/>
                                    </group>
                                </group>
                            </page>

                            <!-- Fatura Satırları -->
                            <page string="Invoice Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <button name="open_line_details"
                                            type="object"
                                            string=""
                                            icon="fa-list"
                                            title="View Line Details"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="unit_code_id"/>
                                        <field name="price_amount"/>
                                        <field name="tax_percent"/>
                                        <field name="line_extension_amount" readonly="1"/>
                                        <field name="tax_amount" readonly="1"/>
                                        <field name="withholding_code"/>
                                        <field name="withholding_rate"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="line_extension_total" readonly="1"/>
                                    <field name="total_without_tax" readonly="1"/>
                                    <field name="tax_total_amount" readonly="1"/>
                                    <field name="withholding_tax_total" readonly="1"/>
                                    <field name="income_withholding_total" readonly="1"/>
                                    <field name="total_with_tax" readonly="1"/>
                                    <field name="payable_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                                </group>
                            </page>

                            <!-- Vergi Alt Toplamları -->
                            <page string="Taxes">
                                <field name="subtotal_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="kind"/>
                                        <field name="percent"/>
                                        <field name="taxable_amount"/>
                                        <field name="tax_amount"/>
                                        <field name="tax_scheme_code"/>
                                        <field name="currency_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Ödeme -->
                            <page string="Payment" name="payment_page">
                                <group>
                                    <group string="Payment Method">
                                        <field name="PaymentMeansCode"/>
                                        <field name="PaymentDueDate"/>
                                        <field name="PaymentChannelCode"/>
                                        <field name="InstructionNote"/>
                                        <field name="PayeeFinancialAccount"/>
                                    </group>
                                    <group string="Payment Terms">
                                        <field name="PaymentTermsNote"/>
                                        <field name="PenaltySurchargePercent"/>
                                        <field name="PenaltyAmount"/>
                                        <field name="PTPaymentDueDate"/>
                                    </group>
                                </group>
                            </page>

                            <!-- İrsaliye Referansları -->
                            <page string="Despatch References">
                                <field name="despatch_reference_ids">
                                    <list editable="bottom">
                                        <field name="despatch_id"/>
                                        <field name="issue_date"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Sipariş -->
                            <page string="Order" name="order_page">
                                <group>
                                    <field name="order_id"/>
                                    <field name="order_issue_date"/>
                                </group>
                            </page>

                            <!-- Notlar -->
                            <page string="Notes">
                                <field name="invoice_note_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>

                            <!-- OKC -->
                            <page string="OKC">
                                <group>
                                    <field name="okc_fis_no"/>
                                    <field name="okc_fis_tarih_saat"/>
                                    <field name="okc_z_rapor_no"/>
                                    <field name="okc_seri_no"/>
                                    <field name="okc_fis_tipi"/>
                                </group>
                            </page>

                            <!-- GIB Durum ve Log -->
                            <page string="GIB Status">
                                <group string="Status Information">
                                    <field name="gib_status" readonly="1" widget="badge"
                                        decoration-success="gib_status == 'approved'"
                                        decoration-warning="gib_status in ['xml_created','sent']"
                                        decoration-danger="gib_status in ['rejected','error']"
                                        decoration-muted="gib_status == 'draft'"/>
                                    <field name="UUID" readonly="1"/>
                                    <field name="gib_envelope_id" readonly="1"/>
                                    <field name="gib_send_date" readonly="1"/>
                                    <field name="gib_response_date" readonly="1"/>
                                    <field name="gib_response_desc" readonly="1"/>
                                </group>
                                <group string="Operation Log">
                                    <field name="gib_log" widget="text" readonly="1" nolabel="1"/>
                                </group>
                            </page>

                            <!-- XML / JSON -->
                            <page string="XML / JSON">
                                <group>
                                    <field name="xml_data" widget="code" readonly="1"/>
                                    <field name="json_data" widget="code" readonly="1"/>
                                </group>
                            </page>

                            <!-- ERP -->
                            <page string="ERP" name="erp_page">
                                <group>
                                    <field name="erp_id"/>
                                    <field name="erp_object_type"/>
                                    <field name="erp_last_sync_date" readonly="1"/>
                                </group>
                            </page>
                                </notebook>

                            </div><!-- /o_iber_form_main_col -->

                            <!-- Sağ kolon: PDF önizleme -->
                            <div class="o_iber_pdf_col" invisible="not pdf_data">
                                <div class="border-bottom mb-2 pb-1 d-flex justify-content-between align-items-center">
                                    <strong class="text-muted small">PDF Preview</strong>
                                </div>
                                <field name="pdf_data" widget="pdf_viewer" nolabel="1"/>
                            </div>

                        </div><!-- /o_iber_form_with_pdf -->
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Invoice Line Detail Form (popup — open_line_details butonu açar) -->
        <record id="view_invoiceline_details_form" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoiceline.details.form</field>
            <field name="model">l10n_tr.ubl.invoiceline</field>
            <field name="arch" type="xml">
                <form string="Line Details">
                    <sheet>
                        <group>
                            <group string="Item Information">
                                <field name="name" readonly="1"/>
                                <field name="quantity" readonly="1"/>
                                <field name="unit_code_id" readonly="1"/>
                                <field name="price_amount" readonly="1"/>
                                <field name="tax_percent" readonly="1"/>
                                <field name="line_extension_amount" readonly="1"/>
                                <field name="tax_amount" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group string="Withholding">
                                <field name="withholding_code"/>
                                <field name="withholding_rate"/>
                                <field name="withholding_amount" readonly="1"/>
                                <field name="income_withholding_rate"/>
                                <field name="income_withholding_amount" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Discount / Surcharge" name="adjustments_page">
                                <field name="adjustment_ids">
                                    <list editable="bottom">
                                        <field name="type"/>
                                        <field name="rate"/>
                                        <field name="base_amount" readonly="1"/>
                                        <field name="amount"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                            <page string="VAT and Other Taxes">
                                <field name="taxextra_ids">
                                    <list editable="bottom">
                                        <field name="tax_type_id"/>
                                        <field name="rate"/>
                                        <field name="amount" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="line_note_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Invoice Line Note List (popup) -->
        <record id="view_invoiceline_note_list" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoiceline.note.list</field>
            <field name="model">l10n_tr.ubl.invoiceline.note</field>
            <field name="arch" type="xml">
                <list editable="bottom" string="Line Notes">
                    <field name="sequence" widget="handle"/>
                    <field name="note"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
