<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ============================================================
             GELEN İRSALİYELER — Form buton: Entegratörden Güncelle
             Giden irsaliyeler — Form buton: Entegratör Durum Sorgula
        ============================================================ -->
        <record id="view_ubl_delivery_note_form_integrator" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.delivery.note.form.integrator</field>
            <field name="model">l10n_tr.ubl.delivery.note</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_delivery_note_form"/>
            <field name="arch" type="xml">
                <button name="action_sync_from_erp" position="replace">
                    <!-- Giden: ERP'den İrsaliyeleri Güncelle (draft) -->
                    <button name="action_sync_from_erp"
                        string="Update Despatch Advices"
                        type="object"
                        class="btn-secondary"
                        invisible="document_direction != 'outgoing' or gib_status != 'draft'"
                        title="Syncs this despatch advice with the latest data from the ERP"/>
                    <!-- Gelen: Bu irsaliyeyi entegratörden güncelle -->
                    <button name="action_fetch_single_incoming"
                        string="Update from Integrator"
                        type="object"
                        class="btn-primary"
                        invisible="document_direction != 'incoming'"
                        title="Updates this despatch advice by fetching XML from the integrator"/>
                </button>
            </field>
        </record>

        <!-- ============================================================
             GELEN İRSALİYELER — Liste server action
        ============================================================ -->
        <record id="action_server_fetch_incoming_from_integrator_despatch" model="ir.actions.server">
            <field name="name">Fetch Despatch Advices from Integrator</field>
            <field name="model_id" ref="iber_e_transform.model_l10n_tr_ubl_delivery_note"/>
            <field name="binding_model_id" ref="iber_e_transform.model_l10n_tr_ubl_delivery_note"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = model.action_fetch_incoming_from_integrator()</field>
        </record>

    </data>
</odoo>
