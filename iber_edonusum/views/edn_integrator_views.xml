<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_edn_integrator_list" model="ir.ui.view">
            <field name="name">edn.integrator.list</field>
            <field name="model">edn.integrator</field>
            <field name="arch" type="xml">
                <list string="Integrators">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="module_name"/>
                    <field name="is_test" widget="boolean_toggle"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_edn_integrator_form" model="ir.ui.view">
            <field name="name">edn.integrator.form</field>
            <field name="model">edn.integrator</field>
            <field name="arch" type="xml">
                <form string="Integrator">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_fetch_series"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                string="Update Series"/>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="module_name"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="is_test" widget="boolean_toggle"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Production Connection" name="prod_creds">
                                <group>
                                    <group string="Connection">
                                        <field name="base_url" placeholder="https://api.entegrator.com"/>
                                    </group>
                                    <group string="Authentication">
                                        <field name="username"/>
                                        <field name="password" password="True"/>
                                        <field name="apikey"/>
                                        <field name="token" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Test Connection" name="test_creds">
                                <group>
                                    <group string="Connection">
                                        <field name="test_base_url" placeholder="https://test-api.entegrator.com"/>
                                    </group>
                                    <group string="Authentication">
                                        <field name="test_username"/>
                                        <field name="test_password" password="True"/>
                                        <field name="test_apikey"/>
                                        <field name="test_token" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Series" name="series">
                                <field name="series_ids" readonly="1">
                                    <list>
                                        <field name="prefix"/>
                                        <field name="document_type"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Additional Parameters" name="extra_params">
                                <field name="extra"
                                    placeholder='{"timeout": 60, "custom_header": "value"}'
                                    nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_edn_integrators" model="ir.actions.act_window">
            <field name="name">Integrators</field>
            <field name="res_model">edn.integrator</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
