<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edn_invoice_uuid_fetch_wizard_form" model="ir.ui.view">
        <field name="name">edn.invoice.uuid.fetch.wizard.form</field>
        <field name="model">edn.invoice.uuid.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Incoming e-Invoice: Fetch by UUID">
                <p class="text-muted">
                    If you know the document's UUID (GUID), this fetches it
                    directly from the integrator without needing a list/date
                    filter.
                </p>
                <group>
                    <field name="doc_uuid" placeholder="ör. e2ab73e2-d0e9-4f83-b1d2-d9960611a885"/>
                </group>
                <footer>
                    <button name="action_fetch" string="Fetch"
                        type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
