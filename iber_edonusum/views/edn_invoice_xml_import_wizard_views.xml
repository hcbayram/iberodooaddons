<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edn_invoice_xml_import_wizard_form" model="ir.ui.view">
        <field name="name">edn.invoice.xml.import.wizard.form</field>
        <field name="model">edn.invoice.xml.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Incoming e-Invoice: Import from XML">
                <p class="text-muted">
                    Directly import the raw UBL-TR XML file of a document
                    that could not be fetched from the integrator (e.g.
                    marked as "received" by another user on a shared test
                    account).
                </p>
                <group>
                    <field name="xml_file" filename="xml_filename"/>
                    <field name="xml_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import"
                        type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
