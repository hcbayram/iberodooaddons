<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edn_invoice_xml_import_wizard_form" model="ir.ui.view">
        <field name="name">edn.invoice.xml.import.wizard.form</field>
        <field name="model">edn.invoice.xml.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Gelen e-Fatura: XML'den İçe Aktar">
                <p class="text-muted">
                    Entegratörden çekilemeyen (ör. paylaşımlı test hesabında
                    başka bir kullanıcı tarafından "alındı" olarak
                    işaretlenmiş) bir belgenin ham UBL-TR XML dosyasını
                    doğrudan içe aktarın.
                </p>
                <group>
                    <field name="xml_file" filename="xml_filename"/>
                    <field name="xml_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="İçe Aktar"
                        type="object" class="btn-primary"/>
                    <button string="İptal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
