<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edn_integrator_form_hizli_ext" model="ir.ui.view">
        <field name="name">edn.integrator.form.hizli.ext</field>
        <field name="model">edn.integrator</field>
        <field name="inherit_id" ref="iber_edonusum.view_edn_integrator_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='prod_creds']//field[@name='token']" position="before">
                <field name="hizli_secretkey" password="True" invisible="code != 'HIZLI'"/>
            </xpath>
            <xpath expr="//page[@name='prod_creds']//field[@name='token']" position="after">
                <field name="hizli_token_expiry" readonly="1" invisible="code != 'HIZLI'"/>
            </xpath>
            <xpath expr="//page[@name='test_creds']//field[@name='test_token']" position="before">
                <field name="hizli_test_secretkey" password="True" invisible="code != 'HIZLI'"/>
            </xpath>
            <xpath expr="//page[@name='test_creds']//field[@name='test_token']" position="after">
                <field name="hizli_test_token_expiry" readonly="1" invisible="code != 'HIZLI'"/>
            </xpath>
        </field>
    </record>
</odoo>
