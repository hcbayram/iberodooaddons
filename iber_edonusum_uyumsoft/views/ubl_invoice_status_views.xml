<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ubl_invoice_form_uyumsoft_status" model="ir.ui.view">
            <field name="name">l10n_tr.ubl.invoice.form.uyumsoft.status</field>
            <field name="model">l10n_tr.ubl.invoice</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl_invoice_form"/>
            <field name="arch" type="xml">

                <!-- GIB Durumu sekmesine Belge Cevabı ve Uyumsoft sorgu tarihi ekle -->
                <field name="gib_response_desc" position="after">
                    <field name="uyumsoft_document_answer" readonly="1"
                        widget="badge"
                        decoration-success="uyumsoft_document_answer == 'accepted'"
                        decoration-warning="uyumsoft_document_answer == 'waiting'"
                        decoration-danger="uyumsoft_document_answer == 'rejected'"
                        decoration-muted="uyumsoft_document_answer == 'none'"
                        invisible="not uyumsoft_document_answer or uyumsoft_document_answer == 'none'"/>
                    <field name="uyumsoft_outgoing_fetch_date" readonly="1"
                        invisible="not uyumsoft_outgoing_fetch_date"/>
                </field>

                <!-- Uyumsoft Yanıtı sekmesini notebook'un sonuna ekle -->
                <xpath expr="//notebook/page[last()]" position="after">
                    <page string="Uyumsoft Yanıtı" invisible="not uyumsoft_outgoing_raw">
                        <group>
                            <field name="uyumsoft_outgoing_fetch_date" readonly="1" string="Son Sorgu"/>
                        </group>
                        <field name="uyumsoft_outgoing_raw" widget="code" readonly="1" nolabel="1"/>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
