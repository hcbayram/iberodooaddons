<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_marketplace_user" model="res.groups">
            <field name="name">Pazaryeri / Kullanıcı</field>
        </record>

        <record id="group_marketplace_manager" model="res.groups">
            <field name="name">Pazaryeri / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_marketplace_user'))]"/>
        </record>

        <record id="rule_marketplace_channel_company" model="ir.rule">
            <field name="name">Pazaryeri Kanalı: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_channel"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_marketplace_user'))]"/>
        </record>

    </data>
</odoo>
