<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_amazon_user" model="res.groups">
            <field name="name">Amazon TR / Kullanıcı</field>
        </record>

        <record id="group_amazon_manager" model="res.groups">
            <field name="name">Amazon TR / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_amazon_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_amazon_config_company" model="ir.rule">
            <field name="name">Amazon Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_amazon_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_amazon_user'))]"/>
        </record>

        <record id="rule_amazon_order_company" model="ir.rule">
            <field name="name">Amazon Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_amazon_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_amazon_user'))]"/>
        </record>

        <record id="rule_amazon_listing_company" model="ir.rule">
            <field name="name">Amazon Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_amazon_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_amazon_user'))]"/>
        </record>

    </data>
</odoo>
