<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_iber_amazon_order_list" model="ir.ui.view">
        <field name="name">iber.marketplace.amazon.order.list</field>
        <field name="model">iber.marketplace.amazon.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="amazon_order_id"/>
                <field name="buyer_name"/>
                <field name="purchase_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'Shipped'"
                       decoration-warning="status in ('Pending', 'Unshipped', 'PartiallyShipped', 'InvoiceUnconfirmed')"
                       decoration-danger="status in ('Canceled', 'Unfulfillable')"/>
                <field name="fulfillment_channel" widget="badge"
                       decoration-info="fulfillment_channel == 'AFN'"
                       decoration-muted="fulfillment_channel == 'MFN'"/>
                <field name="order_total"/>
                <field name="currency_code"/>
                <field name="shipment_sent" widget="boolean_toggle"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_iber_amazon_order_form" model="ir.ui.view">
        <field name="name">iber.marketplace.amazon.order.form</field>
        <field name="model">iber.marketplace.amazon.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_shipment" type="object"
                            string="Kargo Onayla"
                            class="btn-primary"
                            invisible="shipment_sent or fulfillment_channel == 'AFN'"/>
                    <button name="action_create_sale_order" type="object"
                            string="Satış Siparişi Oluştur"
                            class="btn-secondary"
                            invisible="sale_order_id"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="Pending,Unshipped,Shipped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="amazon_order_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Sipariş Bilgileri">
                            <field name="config_id" readonly="1"/>
                            <field name="purchase_date" readonly="1"/>
                            <field name="fulfillment_channel" readonly="1"/>
                            <field name="order_total" readonly="1"/>
                            <field name="currency_code" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                        <group string="Alıcı Bilgileri">
                            <field name="buyer_name" readonly="1"/>
                            <field name="buyer_email" readonly="1"/>
                            <field name="ship_name" readonly="1"/>
                            <field name="ship_address_line1" readonly="1"/>
                            <field name="ship_address_line2" readonly="1"/>
                            <field name="ship_city" readonly="1"/>
                            <field name="ship_state" readonly="1"/>
                            <field name="ship_postal_code" readonly="1"/>
                            <field name="ship_country_code" readonly="1"/>
                        </group>
                    </group>
                    <group string="Kargo Bilgileri"
                           invisible="fulfillment_channel == 'AFN'">
                        <group>
                            <field name="carrier_code"/>
                            <field name="tracking_number"/>
                            <field name="shipment_sent" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kalemler">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="asin"/>
                                    <field name="seller_sku"/>
                                    <field name="title"/>
                                    <field name="quantity_ordered"/>
                                    <field name="quantity_shipped"/>
                                    <field name="item_price"/>
                                    <field name="item_tax"/>
                                    <field name="product_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_iber_amazon_order" model="ir.actions.act_window">
        <field name="name">Amazon TR Siparişleri</field>
        <field name="res_model">iber.marketplace.amazon.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
