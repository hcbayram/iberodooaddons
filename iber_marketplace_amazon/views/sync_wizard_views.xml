<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_iber_amazon_sync_wizard_form" model="ir.ui.view">
        <field name="name">iber.marketplace.amazon.sync.wizard.form</field>
        <field name="model">iber.marketplace.amazon.sync.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="config_id"
                               readonly="state != 'draft'"/>
                        <field name="sync_type"
                               readonly="state != 'draft'" widget="radio"/>
                    </group>
                    <group string="Sipariş Seçenekleri"
                           invisible="sync_type != 'orders'">
                        <field name="order_days_back"
                               readonly="state != 'draft'"/>
                        <field name="include_all_statuses"
                               readonly="state != 'draft'"/>
                    </group>
                    <group string="Sonuç" invisible="state == 'draft'">
                        <field name="state" readonly="1" widget="badge"
                               decoration-success="state == 'done'"
                               decoration-danger="state == 'error'"/>
                        <field name="result_message" readonly="1"
                               invisible="not result_message"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_run" type="object"
                            string="Çalıştır"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Kapat" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
