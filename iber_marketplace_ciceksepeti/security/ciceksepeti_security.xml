<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_ciceksepeti_user" model="res.groups">
            <field name="name">Çiçeksepeti / Kullanıcı</field>
        </record>

        <record id="group_ciceksepeti_manager" model="res.groups">
            <field name="name">Çiçeksepeti / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_ciceksepeti_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_ciceksepeti_config_company" model="ir.rule">
            <field name="name">Çiçeksepeti Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_ciceksepeti_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ciceksepeti_user'))]"/>
        </record>

        <record id="rule_ciceksepeti_order_company" model="ir.rule">
            <field name="name">Çiçeksepeti Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_ciceksepeti_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ciceksepeti_user'))]"/>
        </record>

        <record id="rule_ciceksepeti_listing_company" model="ir.rule">
            <field name="name">Çiçeksepeti Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_ciceksepeti_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ciceksepeti_user'))]"/>
        </record>

    </data>
</odoo>
