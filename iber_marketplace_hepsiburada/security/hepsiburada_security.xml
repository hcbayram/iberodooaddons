<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_hepsiburada_user" model="res.groups">
            <field name="name">Hepsiburada / Kullanıcı</field>
        </record>

        <record id="group_hepsiburada_manager" model="res.groups">
            <field name="name">Hepsiburada / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_hepsiburada_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_hepsiburada_config_company" model="ir.rule">
            <field name="name">Hepsiburada Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_hepsiburada_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_hepsiburada_user'))]"/>
        </record>

        <record id="rule_hepsiburada_order_company" model="ir.rule">
            <field name="name">Hepsiburada Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_hepsiburada_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_hepsiburada_user'))]"/>
        </record>

        <record id="rule_hepsiburada_listing_company" model="ir.rule">
            <field name="name">Hepsiburada Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_hepsiburada_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_hepsiburada_user'))]"/>
        </record>

    </data>
</odoo>
