<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_n11_user" model="res.groups">
            <field name="name">N11 / Kullanıcı</field>
        </record>

        <record id="group_n11_manager" model="res.groups">
            <field name="name">N11 / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_n11_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_n11_config_company" model="ir.rule">
            <field name="name">N11 Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_n11_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_n11_user'))]"/>
        </record>

        <record id="rule_n11_order_company" model="ir.rule">
            <field name="name">N11 Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_n11_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_n11_user'))]"/>
        </record>

        <record id="rule_n11_listing_company" model="ir.rule">
            <field name="name">N11 Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_n11_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_n11_user'))]"/>
        </record>

    </data>
</odoo>
