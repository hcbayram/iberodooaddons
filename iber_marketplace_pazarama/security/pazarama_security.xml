<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_pazarama_user" model="res.groups">
            <field name="name">Pazarama / Kullanıcı</field>
        </record>

        <record id="group_pazarama_manager" model="res.groups">
            <field name="name">Pazarama / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_pazarama_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_pazarama_config_company" model="ir.rule">
            <field name="name">Pazarama Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_pazarama_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pazarama_user'))]"/>
        </record>

        <record id="rule_pazarama_order_company" model="ir.rule">
            <field name="name">Pazarama Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_pazarama_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pazarama_user'))]"/>
        </record>

        <record id="rule_pazarama_listing_company" model="ir.rule">
            <field name="name">Pazarama Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_pazarama_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pazarama_user'))]"/>
        </record>

    </data>
</odoo>
