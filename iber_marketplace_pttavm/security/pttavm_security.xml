<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_pttavm_user" model="res.groups">
            <field name="name">PttAVM / Kullanıcı</field>
        </record>

        <record id="group_pttavm_manager" model="res.groups">
            <field name="name">PttAVM / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_pttavm_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_pttavm_config_company" model="ir.rule">
            <field name="name">PttAVM Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_pttavm_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pttavm_user'))]"/>
        </record>

        <record id="rule_pttavm_order_company" model="ir.rule">
            <field name="name">PttAVM Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_pttavm_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pttavm_user'))]"/>
        </record>

        <record id="rule_pttavm_listing_company" model="ir.rule">
            <field name="name">PttAVM Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_pttavm_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_pttavm_user'))]"/>
        </record>

    </data>
</odoo>
