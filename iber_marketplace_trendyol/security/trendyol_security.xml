<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_trendyol_user" model="res.groups">
            <field name="name">Trendyol / Kullanıcı</field>
        </record>

        <record id="group_trendyol_manager" model="res.groups">
            <field name="name">Trendyol / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_trendyol_user'))]"/>
        </record>

        <!-- Çok şirketli erişim kuralları -->
        <record id="rule_trendyol_config_company" model="ir.rule">
            <field name="name">Trendyol Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_trendyol_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_trendyol_user'))]"/>
        </record>

        <record id="rule_trendyol_order_company" model="ir.rule">
            <field name="name">Trendyol Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_trendyol_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_trendyol_user'))]"/>
        </record>

        <record id="rule_trendyol_listing_company" model="ir.rule">
            <field name="name">Trendyol Ürün Listesi: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_marketplace_trendyol_listing"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_trendyol_user'))]"/>
        </record>

    </data>
</odoo>
