<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_iber_trendyol_listing_list" model="ir.ui.view">
        <field name="name">iber.marketplace.trendyol.listing.list</field>
        <field name="model">iber.marketplace.trendyol.listing</field>
        <field name="arch" type="xml">
            <list>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="odoo_qty"/>
                <field name="trendyol_stock"/>
                <field name="sale_price"/>
                <field name="trendyol_price"/>
                <field name="last_push"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_iber_trendyol_listing_form" model="ir.ui.view">
        <field name="name">iber.marketplace.trendyol.listing.form</field>
        <field name="model">iber.marketplace.trendyol.listing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_push_inventory" type="object"
                            string="Stok / Fiyat Gönder"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="barcode" placeholder="Barkod / SKU"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tanım">
                            <field name="config_id"/>
                            <field name="product_id"/>
                            <field name="active"/>
                            <field name="trendyol_product_name" readonly="1"/>
                        </group>
                        <group string="Stok &amp; Fiyat">
                            <field name="odoo_qty" readonly="1"/>
                            <field name="trendyol_stock" readonly="1"/>
                            <field name="sale_price" readonly="1"/>
                            <field name="trendyol_price" readonly="1"/>
                            <field name="last_push" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_iber_trendyol_listing" model="ir.actions.act_window">
        <field name="name">Trendyol Ürün Listesi</field>
        <field name="res_model">iber.marketplace.trendyol.listing</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
