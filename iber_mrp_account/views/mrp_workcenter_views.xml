<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_inherit_721_731" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.721.731</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp_account.mrp_workcenter_view_inherit"/>
        <field name="arch" type="xml">
            <!-- expense_account_id'nin altına 721/731 ayrımını ekle -->
            <field name="expense_account_id" position="after">
                <separator string="İşçilik / GÜG Maliyet Ayrımı (7/A)"/>
                <field name="account_721_id"
                       string="721 Direkt İşçilik Hesabı"
                       options="{'no_create': True}"/>
                <field name="costs_hour_721"
                       string="Saatlik İşçilik Maliyeti (721)"
                       widget="monetary"/>
                <field name="account_731_id"
                       string="731 Genel Üretim Giderleri Hesabı"
                       options="{'no_create': True}"/>
                <field name="costs_hour_731"
                       string="Saatlik GÜG Maliyeti (731)"
                       widget="monetary"/>
            </field>
        </field>
    </record>
</odoo>
