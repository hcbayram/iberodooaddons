<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_710_711_account" model="ir.ui.view">
        <field name="name">product.category.form.710.711.account</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="iber_mrp_cost_accounts"
                       groups="account.group_account_readonly">
                    <group string="Direkt Maliyet Hesapları (7/A)">
                        <field name="property_account_710_id"
                               string="710 Direkt Hammadde Giderleri (DR)"
                               options="{'no_create': True}"/>
                        <field name="property_account_711_id"
                               string="711 Direkt Hammadde Yansıtma (CR)"
                               options="{'no_create': True}"/>
                        <field name="property_stock_account_production_cost_id"
                               string="WIP / Üretim Hesabı (151)"
                               options="{'no_create': True}"
                               invisible="property_valuation != 'real_time'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
