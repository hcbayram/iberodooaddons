<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transaction List -->
    <record id="view_pavo_transaction_list" model="ir.ui.view">
        <field name="name">iber.pavo.transaction.tree</field>
        <field name="model">iber.pavo.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Tarih"/>
                <field name="name"/>
                <field name="terminal_id"/>
                <field name="sale_type"/>
                <field name="order_no"/>
                <field name="sale_number"/>
                <field name="amount"/>
                <field name="currency_code"/>
                <field name="invoice_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Transaction Form -->
    <record id="view_pavo_transaction_form" model="ir.ui.view">
        <field name="name">iber.pavo.transaction.form</field>
        <field name="model">iber.pavo.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_query_result" type="object"
                            string="Durumu Sorgula"
                            invisible="state in ('success', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,success,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="İşlem Bilgileri">
                            <field name="terminal_id"/>
                            <field name="sale_type"/>
                            <field name="sale_reason"/>
                            <field name="order_no"/>
                            <field name="sale_number"/>
                            <field name="pavo_sale_id"/>
                        </group>
                        <group string="Tutar">
                            <field name="amount"/>
                            <field name="currency_code"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Yanıt (JSON)" invisible="not response_json">
                            <field name="response_json" widget="code" readonly="1"/>
                        </page>
                        <page string="İstek (JSON)" invisible="not request_json">
                            <field name="request_json" widget="code" readonly="1"/>
                        </page>
                        <page string="Hata" invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Transaction Action -->
    <record id="action_pavo_transaction" model="ir.actions.act_window">
        <field name="name">İşlemler</field>
        <field name="res_model">iber.pavo.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
