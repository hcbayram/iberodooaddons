<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- iber_e_transform ayarlar formuna SAP B1 sekmesi ekle -->
        <record id="view_ubl21_config_settings_sap_b1" model="ir.ui.view">
            <field name="name">ubl21.config.settings.sap_b1.inherit</field>
            <field name="model">ubl21.config.settings</field>
            <field name="inherit_id" ref="iber_e_transform.view_ubl21_config_settings_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="SAP Business One"
                        invisible="active_erp != 'sap_b1'">
                        <group string="Service Layer Bağlantısı">
                            <field name="sap_service_layer_url"/>
                            <field name="sap_company_db"/>
                            <field name="sap_username"/>
                            <field name="sap_password" password="True"/>
                        </group>
                        <group string="SQL Server (Opsiyonel)">
                            <field name="sql_server"/>
                            <field name="sql_database"/>
                            <field name="sql_username"/>
                            <field name="sql_password" password="True"/>
                            <field name="sql_port"/>
                        </group>
                        <group>
                            <button name="action_sync_branches_from_sap"
                                string="SAP'den Şubeleri Senkronize Et"
                                type="object"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
