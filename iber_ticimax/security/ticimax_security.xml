<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_ticimax_user" model="res.groups">
            <field name="name">Ticimax / Kullanıcı</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ticimax_manager" model="res.groups">
            <field name="name">Ticimax / Yönetici</field>
            <field name="implied_ids" eval="[(4, ref('group_ticimax_user'))]"/>
        </record>

        <record id="rule_ticimax_config_company" model="ir.rule">
            <field name="name">Ticimax Config: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_ticimax_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ticimax_user'))]"/>
        </record>

        <record id="rule_ticimax_order_company" model="ir.rule">
            <field name="name">Ticimax Sipariş: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_ticimax_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ticimax_user'))]"/>
        </record>

        <record id="rule_ticimax_product_company" model="ir.rule">
            <field name="name">Ticimax Ürün: Şirket Bazlı</field>
            <field name="model_id" ref="model_iber_ticimax_product"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ticimax_user'))]"/>
        </record>

    </data>
</odoo>
