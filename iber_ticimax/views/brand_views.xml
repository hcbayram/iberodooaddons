<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ticimax_brand_list" model="ir.ui.view">
        <field name="name">iber.ticimax.brand.list</field>
        <field name="model">iber.ticimax.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="ticimax_id"/>
                <field name="tanim"/>
                <field name="aktif" widget="boolean_toggle"/>
                <field name="config_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ticimax_brand_form" model="ir.ui.view">
        <field name="name">iber.ticimax.brand.form</field>
        <field name="model">iber.ticimax.brand</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_push_to_ticimax" type="object"
                            string="Ticimax'a Gönder" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Ticimax Bilgileri">
                            <field name="config_id"/>
                            <field name="ticimax_id" readonly="1"/>
                            <field name="tanim" readonly="1"/>
                            <field name="aktif" readonly="1"/>
                        </group>
                        <group string="SEO">
                            <field name="seo_anahtar_kelime" readonly="1"/>
                            <field name="seo_sayfa_aciklama" readonly="1"/>
                            <field name="seo_sayfa_baslik" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ticimax_brand" model="ir.actions.act_window">
        <field name="name">Ticimax Markalar</field>
        <field name="res_model">iber.ticimax.brand</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
