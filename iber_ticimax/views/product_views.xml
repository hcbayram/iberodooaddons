<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ticimax_product_list" model="ir.ui.view">
        <field name="name">iber.ticimax.product.list</field>
        <field name="model">iber.ticimax.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_tmpl_id"/>
                <field name="ticimax_id"/>
                <field name="ticimax_kategori_id"/>
                <field name="ticimax_marka_id"/>
                <field name="sync_state" widget="badge"
                       decoration-success="sync_state == 'synced'"
                       decoration-danger="sync_state == 'error'"
                       decoration-warning="sync_state == 'pending'"/>
                <field name="last_sync"/>
                <field name="config_id" column_invisible="True"/>
                <button name="action_push_to_ticimax" type="object"
                        string="Gönder" icon="fa-upload" class="btn-sm btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_ticimax_product_form" model="ir.ui.view">
        <field name="name">iber.ticimax.product.form</field>
        <field name="model">iber.ticimax.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_push_to_ticimax" type="object"
                            string="Ticimax'a Gönder" class="btn-primary"/>
                    <field name="sync_state" widget="statusbar"
                           statusbar_visible="pending,synced,error"/>
                </header>
                <sheet>
                    <group>
                        <group string="Eşleşme">
                            <field name="config_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="ticimax_id" readonly="1"/>
                        </group>
                        <group string="Ticimax Sınıflandırma">
                            <field name="ticimax_kategori_id"/>
                            <field name="ticimax_marka_id"/>
                        </group>
                    </group>
                    <group string="Sync Durumu" invisible="sync_state == 'pending'">
                        <field name="last_sync" readonly="1"/>
                        <field name="last_error" readonly="1"
                               invisible="not last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ticimax_product" model="ir.actions.act_window">
        <field name="name">Ticimax Ürünler</field>
        <field name="res_model">iber.ticimax.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
