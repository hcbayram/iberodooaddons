<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ticimax_sync_wizard_form" model="ir.ui.view">
        <field name="name">iber.ticimax.sync.wizard.form</field>
        <field name="model">iber.ticimax.sync.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="config_id"/>
                        <field name="sync_type"/>
                        <field name="siparis_durum_filtre"
                               invisible="sync_type not in ['orders', 'all_orders']"/>
                        <field name="entegrasyon_aktarilmamis"
                               invisible="sync_type not in ['orders', 'all_orders']"/>
                    </group>
                    <group invisible="state == 'draft'">
                        <field name="result_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_sync" type="object" string="Başlat"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_close" type="object" string="Kapat"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ticimax_sync_wizard" model="ir.actions.act_window">
        <field name="name">Ticimax Senkronizasyon</field>
        <field name="res_model">iber.ticimax.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
